{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SignalHub",
  "mainBinaryName": "signalhub-app",
  "version": "0.3.3",
  "identifier": "app.signalhub.desktop",
  "build": {
    "beforeDevCommand": "node scripts/stage-cli.mjs --debug && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && node scripts/stage-cli.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SignalHub",
        "url": "index.html?window=light",
        "width": 42,
        "height": 42,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visible": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "noRedirectionBitmap": true
      },
      {
        "label": "settings",
        "title": "SignalHub 设置",
        "url": "index.html?window=settings",
        "width": 720,
        "height": 690,
        "resizable": false,
        "center": true,
        "visible": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/signalhub"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwQ0ExNzNFRDkwNzk4NzIKUldSeW1BZlpQaGZLY0lhaWlFbk1MM3g0TVNaRDBnZnZtTkZ4anJPQWwxY1JZQVBtTlNmQ0gzeFkK",
      "endpoints": [
        "https://github.com/iFishin/SignalHub/releases/latest/download/latest.json"
      ]
    }
  }
}
