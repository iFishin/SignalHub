{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "灯球窗口、各组自己的灯窗与设置窗口",
  "windows": ["main", "settings", "inbox", "lamp-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "dialog:allow-open",
    "dialog:allow-save",
    "updater:default"
  ]
}
